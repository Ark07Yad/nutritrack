# Generate these with `npm run keys`, then copy them here.
# The private key is a credential — keep it out of version control.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Where to listen.
PORT=8787

# Comma-separated origins allowed to call this API.
# Use the real origin of your deployed app in production, not "*".
ALLOWED_ORIGINS=http://localhost:5180

# SQLite file. Mount this path as a volume if you deploy in a container.
DATABASE_PATH=./data/push.db
